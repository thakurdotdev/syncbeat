# ==========================================
# SYNCBEAT MONOREPO ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# Frontend / Vite Environment Variables (Vercel & Client)
# ------------------------------------------
# Optional in Vercel Production (defaults to same domain origin if empty)
VITE_API_URL=http://localhost:4000

# Audio asset CDN / Server URL
VITE_SONG_URL=

# ------------------------------------------
# Backend / Server Environment Variables (Vercel & Server)
# ------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production
CLIENT_URL=http://localhost:5173
PRODUCTION_DOMAINS=https://syncbeat.vercel.app

# Email / Resend settings (Optional)
RESEND_API_KEY=
RESEND_EMAIL=
